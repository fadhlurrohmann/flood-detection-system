# ============================================================
#  EFWS — Environment Variables
#  cp .env.example .env  →  edit the values below  →  do not commit .env to git
# ============================================================

# ── Device identity ──────────────────────────────────────────
EFWS_DEVICE_ID=FLOOD-JAM-TEST02
EFWS_DEVICE_TOKEN=test

# ── Operating mode ───────────────────────────────────────────
# "mock"     → testing without hardware (sensor values are simulated)
# "hardware" → access GPIO/SPI/I2C + auto-detect the A7670E or SIM7600 SIM
EFWS_RUN_MODE=mock

# ── REST API ──────────────────────────────────────────────────
# 4 endpoints are used, all derived from EFWS_API_URL:
#   EFWS_API_URL/sensors/location       (endpoint 1, scheduled)
#   EFWS_API_URL/sensors/telemetry      (endpoint 2, scheduled, carries 'config')
#   EFWS_API_URL/sensors/heartbeat      (endpoint 3, scheduled, carries 'commands')
#   EFWS_API_URL/sensors/commands/ack   (endpoint 4, event-driven)
# For prototyping: open https://webhook.site, copy the unique URL here
# (endpoint 4 will never be called from webhook.site because it never
# returns 'commands' -- use tools/mock_api_server.py if you
# want to test commands/reboot end-to-end).
EFWS_API_URL=https://webhook.site/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EFWS_API_KEY=

# ── GPS fallback (used if the SIM GPS gets no fix) ───────────
EFWS_LAT=-1.2654
EFWS_LON=116.8312
EFWS_GPS_TIMEOUT=90
# EFWS_GPS_INTERVAL is no longer used -- GPS is now refreshed EVERY
# read cycle (EFWS_READ_INTERVAL), per the new scheduler.

# ── Timing ───────────────────────────────────────────────────
# Sensor CHECK cycle -- always runs every this interval, purely evaluating
# thresholds (fast, for emergency response). It does NOT mean data is always sent.
EFWS_READ_INTERVAL=180

# ROUTINE SEND cycle (location+telemetry+heartbeat) in NORMAL conditions.
# Thresholds are still checked every EFWS_READ_INTERVAL (fast response in an
# emergency), but when everything is normal, the device only needs to report routinely every this interval
# so it does not look dead/missing. As soon as ANY threshold is crossed,
# send IMMEDIATELY at that moment (emergency, without waiting for this schedule),
# and the routine schedule is reset from that point too.
EFWS_ROUTINE_SEND_INTERVAL_SEC=360

# Offline queue retry -- runs in a SEPARATE THREAD, independent of
# EFWS_READ_INTERVAL, so it stays exactly every 2 minutes even if the sensor
# read cycle is 3 minutes.
EFWS_CONNECTIVITY_CHECK_SEC=120

# ── Command executor (endpoint 4: /sensors/commands/ack) ────
# Delay before systemctl restart is actually executed after a
# "Reboot" command is received via heartbeat -- MUST be > 0 so the ACK gets
# sent first before this process dies from its own restart.
# EFWS_REBOOT_DELAY_SEC=5
#
# IMPORTANT -- deployment requirement: the user running efws.service
# (see User= in efws.service) must be able to run:
#   sudo -n systemctl restart efws.service
# WITHOUT a password prompt, or the Reboot command will always fail (FAILED).
# Add the following line to /etc/sudoers.d/efws (change 'uwfadmin' to match
# User= in efws.service):
#   uwfadmin ALL=(root) NOPASSWD: /usr/bin/systemctl restart efws.service

# ── SIM (port auto-detect via sim_detector.py) ───────────────
# Leave empty to auto-detect. Fill in only if you want to pin to a specific port.
# EFWS_SIM_PORT=/dev/ttyUSB2
EFWS_APN=internet

# ── Battery — DC 0-25V Voltage Sensor Module ──────────────────
# The voltage sensor is tapped directly at the Battery+ / Battery− terminals
# (NOT at the buck converter output).
# EFWS_BATTERY_DIVIDER_RATIO=5.0   # battery V / V at pin S (measure with a multimeter to calibrate)
# EFWS_BATTERY_MAX_V=12.6          # FULL battery voltage (LiFePO4: 14.4V, Li-ion: 12.6V)
# EFWS_BATTERY_MIN_V=9.0           # EMPTY battery voltage

# ── SPI / MCP3008 channel mapping ────────────────────────────
# EFWS_ADC_PRESSURE=2
# EFWS_ADC_BATTERY=3

# ── GPIO ─────────────────────────────────────────────────────
# EFWS_FLOW_SENSOR_PIN=4
# EFWS_GPIO_FLAME=17
# EFWS_GPIO_RELAY=27
# EFWS_GPIO_LED=23
# EWF_JSN_TRIG=22
# EWF_GPIO_ECHO=18
# EWS_GPIO_YF_S201=16

# ── RS485 wind-speed anemometer (Modbus RTU) ──────────────────
# Confirm the register and scale for your anemometer model's datasheet.
# EFWS_ANEM_PORT=/dev/ttyUSB0
# EFWS_ANEM_BAUDRATE=9600
# EFWS_ANEM_SLAVE_ID=1
# EFWS_ANEM_SPEED_REGISTER=0
# EFWS_ANEM_FUNCTION_CODE=3
# EFWS_ANEM_SPEED_SCALE=0.1

# ── I2C ──────────────────────────────────────────────────────
# EFWS_BME280_ADDR=0x76
#

# ── Database & logging ────────────────────────────────────────
# EFWS_DB_PATH=database/efws_data.db
# EFWS_LOG_PATH=logs/efws.log

# ── Internal API ─────────────────────────────────────────────
# EFWS_VERIFY_SSL=true
# EFWS_ANEM_PORT=/dev/ttyUSB0
