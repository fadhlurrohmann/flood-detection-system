# ============================================================
#  EFWS — Environment Variables
#  cp .env.example .env  →  edit value below  →  do not commit .env to git
# ============================================================

# ── Identitas device ──────────────────────────────────────
EFWS_DEVICE_ID=FLOOD-JAM-TEST02
EFWS_DEVICE_TOKEN=test

# ── Mode operation ─────────────────────────────────────────────
# "mock"     → testing without hardware (value sensor simulated)
# "hardware" → access GPIO/SPI/I2C + auto-detect SIM A7670E or SIM7600
EFWS_RUN_MODE=mock

# ── REST API ──────────────────────────────────────────────────
# 4 endpoint used, all in-derive from EFWS_API_URL:
#   EFWS_API_URL/sensors/location       (endpoint 1, scheduled)
#   EFWS_API_URL/sensors/telemetry      (endpoint 2, scheduled, bawa 'config')
#   EFWS_API_URL/sensors/heartbeat      (endpoint 3, scheduled, bawa 'commands')
#   EFWS_API_URL/sensors/commands/ack   (endpoint 4, event-driven)
# For prototyping: open https://webhook.site, copy URL unik to here
# (endpoint 4 not will ever terpanggil from webhook.site because not
# ever returns 'commands' -- pakai tools/mock_api_server.py if
# mau test command/reboot end-to-end).
EFWS_API_URL=https://webhook.site/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EFWS_API_KEY=

# ── GPS fallback (used if SIM GPS not got fix) ─────
EFWS_LAT=-1.2654
EFWS_LON=116.8312
EFWS_GPS_TIMEOUT=90
# EFWS_GPS_INTERVAL not again used -- GPS now in-refresh EVERY
# cycle read (EFWS_READ_INTERVAL), according to scheduler then.

# ── Timing ───────────────────────────────────────────────────
# Cycle CHECK sensor -- always running every this, purely evaluation threshold
# (fast, for response darurat). NOT means always send data.
EFWS_READ_INTERVAL=180

# Cycle SEND RUTIN (location+telemetry+heartbeat) when condition NORMAL.
# Threshold still checked every EFWS_READ_INTERVAL (response fast if
# darurat), but if all normal, device enough report rutin every this
# so that not appear off/lost. Once EXISTS threshold that exceeded,
# send DIRECTLY when that also (emergency, not waiting schedule this),
# and schedule rutin ikut in-reset from point that.
EFWS_ROUTINE_SEND_INTERVAL_SEC=360

# Retry offline queue -- berjalan in THREAD TERPISAH, independent from
# EFWS_READ_INTERVAL, so that still exactly every 2 menit although cycle read
# sensor 3 menit.
EFWS_CONNECTIVITY_CHECK_SEC=120

# ── Command executor (endpoint 4: /sensors/commands/ack) ────
# Delay before systemctl restart actually dieksekusi after command
# "Reboot" received lewat heartbeat -- REQUIRED > 0 so that ACK sempat
# sent first before process this off because restart-nya its own.
# EFWS_REBOOT_DELAY_SEC=5
#
# IMPORTANT -- deployment requirement: user that run efws.service
# (see User= in efws.service) must can run:
#   sudo -n systemctl restart efws.service
# WITHOUT prompt password, or command Reboot will always failed (FAILED).
# Tambahkan baris following to /etc/sudoers.d/efws (replace 'uwfadmin' according to
# User= in efws.service):
#   uwfadmin ALL=(root) NOPASSWD: /usr/bin/systemctl restart efws.service

# ── SIM (port auto-detect via sim_detector.py) ───────────────
# Leave empty for auto-detect. Isi only if ingin pin to port specific.
# EFWS_SIM_PORT=/dev/ttyUSB2
EFWS_APN=internet

# ── smokeLevel (gabungan MQ-2 + MQ-135 → 0-100%) ────────────
# Formula: (mq2/MQ2_CRIT*W_MQ2 + mq135/MQ135_CRIT*W_MQ135) * 100
# Default: MQ-2 bobot 55%, MQ-135 bobot 45%, warning ≥60%, critical ≥70%
# EFWS_SMOKE_MQ2_CRIT=1000.0
# EFWS_SMOKE_MQ135_CRIT=1000.0
# EFWS_SMOKE_W_MQ2=0.55
# EFWS_SMOKE_W_MQ135=0.45
# EFWS_SMOKE_WARN=60.0
# EFWS_SMOKE_CRIT=70.0

# ── Battery — Module Sensor Tegangan DC 0-25V ──────────────────
# Voltage sensor ditap in terminal Battery+ / Battery− directly
# (NOT in output buck converter).
# EFWS_BATTERY_SENSOR_MAX_V=25.0   # max input module sensor (V) — do not changed kecuali replace module
# EFWS_BATTERY_MAX_V=12.6          # tegangan battery PENUH (LiFePO4: 14.4V, Li-ion: 12.6V)
# EFWS_BATTERY_MIN_V=9.0           # tegangan battery EMPTY

# ── SPI / MCP3008 channel mapping ────────────────────────────
# EFWS_ADC_MQ2=0
# EFWS_ADC_MQ135=1
# EFWS_ADC_SOIL_SURFACE=2
# EFWS_ADC_SOIL_DEEP=3
# EFWS_ADC_FLAME_AO=4
# EFWS_ADC_BATTERY=5

# ── GPIO ─────────────────────────────────────────────────────
# EFWS_FLOW_SENSOR_PIN=4
# EFWS_GPIO_FLAME=17
# EFWS_GPIO_RELAY=27
# EFWS_GPIO_LED=23
# EWF_JSN_TRIG=22
# EWF_GPIO_ECHO=18
# EWS_GPIO_YF_S201=16

# ── I2C ──────────────────────────────────────────────────────
# EFWS_BME280_ADDR=0x76
# 

# ── Database & logging ────────────────────────────────────────
# EFWS_DB_PATH=database/efws_data.db
# EFWS_LOG_PATH=logs/efws.log

# ── API internal ─────────────────────────────────────────────
# EFWS_VERIFY_SSL=true
# EFWS_ANEM_PORT=/dev/ttyUSB0
