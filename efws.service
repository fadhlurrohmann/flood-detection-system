[Unit]
Description=Early Fire Warning System (EFWS)
After=network-online.target gsm-connect.service
Requires=gsm-connect.service

[Service]
# ── Change the path to match the install location on the Raspberry Pi ──
# This project's structure is FLAT: main.py is directly in the project root
# (alongside venv/, .env, scripts/, logs/, database/)
WorkingDirectory=/home/uwfadmin/ews
ExecStart=/home/uwfadmin/ews/venv/bin/python main.py

# ── Environment ───────────────────────────────────────
# systemd reads the .env file DIRECTLY - the single source of truth,
# the same as when run manually via `python main.py`.
# The "-" in front of the path means it does not fail if the file does not exist yet.
EnvironmentFile=-/home/uwfadmin/ews/.env

# ── Restart policy ────────────────────────────────────
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# ── Output to journald (journalctl -u efws -f) ────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=efws

# ── User (run as a normal user, NOT root) ─────────────
# Change "pi" to match your Raspberry Pi username. This user MUST be in the
# gpio, spi, i2c, dialout groups to access GPIO/SPI/I2C/serial ports
# without sudo (see the user preparation step in docs/DEPLOYMENT.md).
User=uwfadmin
Group=uwfadmin

[Install]
WantedBy=multi-user.target
