[Unit]
Description=Early Fire Warning System (EFWS)
After=network-online.target gsm-connect.service
Requires=gsm-connect.service

[Service]
# ── Ganti path sesuai lokasi install di Raspberry Pi ──
# Struktur project ini FLAT: main.py directly di root project
# (sejajar with venv/, .env, scripts/, logs/, database/)
WorkingDirectory=/home/uwfadmin/ews
ExecStart=/home/uwfadmin/ews/venv/bin/python main.py

# ── Environment ───────────────────────────────────────
# systemd reading file .env LANGSUNG - satu-satunya sumber kebenaran,
# sama seperti when run manual through `python main.py`.
# Tanda "-" di depan path berarti not failed if file belum ada.
EnvironmentFile=-/home/uwfadmin/ews/.env

# ── Restart policy ────────────────────────────────────
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# ── Output ke journald (journalctl -u efws -f) ────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=efws

# ── User (run sebagai user biasa, NOT root) ────
# Ganti "pi" sesuai username Raspberry Pi Anda. User ini WAJIB ada di
# grup gpio, spi, i2c, dialout so that bisa akses GPIO/SPI/I2C/serial port
# without sudo (see docs/DEPLOYMENT.md langkah persiapan user).
User=uwfadmin
Group=uwfadmin

[Install]
WantedBy=multi-user.target
