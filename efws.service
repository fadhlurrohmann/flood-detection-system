[Unit]
Description=Early Fire Warning System (EFWS)
After=network-online.target gsm-connect.service
Requires=gsm-connect.service

[Service]
# ── Replace path according to location install in Raspberry Pi ──
# Structure project this FLAT: main.py directly in root project
# (sejajar with venv/, .env, scripts/, logs/, database/)
WorkingDirectory=/home/uwfadmin/ews
ExecStart=/home/uwfadmin/ews/venv/bin/python main.py

# ── Environment ───────────────────────────────────────
# systemd reading file .env DIRECTLY - only source of truth,
# same like when run manual through `python main.py`.
# Tanda "-" in depan path means not failed if file does not yet have.
EnvironmentFile=-/home/uwfadmin/ews/.env

# ── Restart policy ────────────────────────────────────
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# ── Output to journald (journalctl -u efws -f) ────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=efws

# ── User (run as user regular, NOT root) ────
# Replace "pi" according to username Raspberry Pi You. User this REQUIRED exists in
# group gpio, spi, i2c, dialout so that can access GPIO/SPI/I2C/serial port
# without sudo (see docs/DEPLOYMENT.md step preparation user).
User=uwfadmin
Group=uwfadmin

[Install]
WantedBy=multi-user.target
